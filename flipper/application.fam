App(
    appid="flibuddy",
    name="FliBuddy",
    apptype=FlipperAppType.EXTERNAL,
    entry_point="flibuddy_app",
    requires=["gui", "bt"],
    stack_size=4 * 1024,
    fap_category="Tools",
    fap_version="0.1",
    fap_icon="icons/flibuddy_10px.png",
    fap_description="Reads filament spool NFC tags and syncs them with Bambuddy over USB or Bluetooth",
    fap_author="Gennady Sokolachko",
    # Only the app sources: host-compiled tests and the SDK stay out.
    sources=["src/*.c", "src/crypto/*.c", "!tests", "!.ufbt", "!dist"],
)
